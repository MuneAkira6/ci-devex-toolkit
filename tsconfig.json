{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "oss-inventory",
    "devcontainer-io-ab",
    "pr-compile-check",
    "two-repos-one-worktree",
    "tools",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "oss-inventory/samples",
    "oss-inventory/fixtures",
    "devcontainer-io-ab/sample",
    "devcontainer-io-ab/results",
    "**/out"
  ]
}
