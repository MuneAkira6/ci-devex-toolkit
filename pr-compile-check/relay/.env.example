# Copy this file to .env on the runner machine and fill in the real values; .env is git-ignored and
# never leaves that machine. Every value here is a dummy.
#
# The relay is the only thing that knows these. Nothing in the workflow, and nothing in any build,
# ever sees them: that is the point of putting a relay on the runner at all.

# The authenticating proxy the relay forwards to.
UPSTREAM_HOST=proxy.example.invalid
UPSTREAM_PORT=8080
UPSTREAM_USER=dummy-user
UPSTREAM_PASSWORD=dummy-password

# The port the relay is published on, bound to 127.0.0.1 only.
RELAY_PORT=3128
